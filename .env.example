# coding-repo-jobs — local/dev environment template

# Identity
SERVICE_NAME=coding-repo-jobs
ENVIRONMENT=development
DEBUG=false
PORT=8695

# Database (psycopg v3 driver enforced). No host Postgres: start a throwaway
# `docker run --rm -d --tmpfs /var/lib/postgresql -p 127.0.0.1::5432 -e POSTGRES_PASSWORD=postgres postgres:18`
# and put its mapped port (`docker port <cid> 5432/tcp`) here. Tests need none of
# this -- with DATABASE_URL unset they start their own ephemeral postgres:18.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:<mapped-port>/postgres

# Backend micro-services (in-cluster names in prod)
CONTAINERS_URL=http://coding-containers:8691
SECURITY_URL=http://coding-security:8693
GITHUB_URL=http://coding-github:8692

# Tenant the worker presents to the backends (single bulk-execution operator)
WORKER_TENANT_ID=00000000-0000-0000-0000-000000000003

# coding-github gates repos owned by PLATFORM_REPO_OWNER to the platform tenants.
# Calls about those repos assert PLATFORM_TENANT_ID; every other target keeps
# WORKER_TENANT_ID. ...0003 is fr's EXECUTION workspace (nonagentic-exec) --
# this conveyor's own identity; see src/config/settings.py for the full
# argument. Neither may be blank in production (_REQUIRED_IN_PRODUCTION).
PLATFORM_REPO_OWNER=nonagenticai
PLATFORM_TENANT_ID=0195f48b-d000-7000-8000-000000000003

# No GitHub token: GitHub access is only via the GitHub Apps behind coding-github.

# Worker loop
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=2
UPGRADE_TIMEOUT_SECONDS=600
TEST_TIMEOUT_SECONDS=300
HTTP_TIMEOUT_SECONDS=900
RETRY_BACKOFF_SECONDS=30

LOG_LEVEL=INFO
